{
  "$schema": "../manifest.schema.json",
  "extends": [
    "base/common.jsonc",
    "base/openssl3.jsonc"
  ],
  "executable_package": "qbittorrent",
  "target_glibc": "2.34",
  "packages": {
    "boost": {
      "source": {
        "github": "boostorg/boost",
        "tag_range": ">=1.88,<2",
        "asset": "{tag}-cmake.tar.gz"
      }
    },
    "libtorrent-rasterbar": {
      "source": {
        "github": "arvidn/libtorrent",
        "tag_range": ">=2,<2.1",
        "asset": "libtorrent-rasterbar-{version}.tar.gz",
        "allow_backfill_source": true
      },
      "cxx_std": "c++17"
    },
    "qtbase": {
      "source": {
        "github": "qt/qtbase",
        "tag_range": ">=6.8,<6.9",
        "url_template": "https://download.qt.io/archive/qt/6.8/{version}/submodules/qtbase-everywhere-opensource-src-{version}.tar.xz"
      }
    },
    "qttools": {
      "source": {
        "github": "qt/qttools",
        "tag_range": ">=6.8,<6.9",
        "url_template": "https://download.qt.io/archive/qt/6.8/{version}/submodules/qttools-everywhere-opensource-src-{version}.tar.xz"
      }
    },
    "qbittorrent": {
      "source": {
        "github": "qbittorrent/qBittorrent",
        "tag_range": ">=5.2,<5.3"
      },
      "cxx_std": "c++20"
    }
  }
}
